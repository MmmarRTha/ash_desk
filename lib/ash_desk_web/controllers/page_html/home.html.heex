<Layouts.flash_group flash={@flash} />

<div class="relative min-h-screen overflow-hidden">
  <!-- Decorative background -->
  <div class="absolute inset-0 -z-10">
    <svg
      viewBox="0 0 1480 957"
      fill="none"
      aria-hidden="true"
      class="absolute inset-0 h-full w-full"
      preserveAspectRatio="xMidYMid slice"
    >
      <path fill="#EE7868" d="M0 0h1480v957H0z" />
      <path
        d="M137.542 466.27c-582.851-48.41-988.806-82.127-1608.412 658.2l67.39 810 3083.15-256.51L1535.94-49.622l-98.36 8.183C1269.29 281.468 734.115 515.799 146.47 467.012l-8.928-.742Z"
        fill="#FF9F92"
      />
      <path
        d="M371.028 528.664C-169.369 304.988-545.754 149.198-1361.45 665.565l-182.58 792.025 3014.73 694.98 389.42-1689.25-96.18-22.171C1505.28 697.438 924.153 757.586 379.305 532.09l-8.277-3.426Z"
        fill="#FA8372"
      />
      <path
        d="M359.326 571.714C-104.765 215.795-428.003-32.102-1349.55 255.554l-282.3 1224.596 3047.04 722.01 312.24-1354.467C1411.25 1028.3 834.355 935.995 366.435 577.166l-7.109-5.452Z"
        fill="#E96856"
        fill-opacity=".6"
      />
      <path
        d="M1593.87 1236.88c-352.15 92.63-885.498-145.85-1244.602-613.557l-5.455-7.105C-12.347 152.31-260.41-170.8-1225-131.458l-368.63 1599.048 3057.19 704.76 130.31-935.47Z"
        fill="#C42652"
        fill-opacity=".2"
      />
      <path
        d="M1411.91 1526.93c-363.79 15.71-834.312-330.6-1085.883-863.909l-3.822-8.102C72.704 125.95-101.074-242.476-1052.01-408.907l-699.85 1484.267 2837.75 1338.01 326.02-886.44Z"
        fill="#A41C42"
        fill-opacity=".2"
      />
      <path
        d="M1116.26 1863.69c-355.457-78.98-720.318-535.27-825.287-1115.521l-1.594-8.816C185.286 163.833 112.786-237.016-762.678-643.898L-1822.83 608.665 571.922 2635.55l544.338-771.86Z"
        fill="#A41C42"
        fill-opacity=".2"
      />
    </svg>
  </div>

  <div class="relative px-4 py-8">
    <div class="mx-auto max-w-5xl">
      <!-- Navbar -->
      <div class="navbar bg-base-200/80 glass rounded-box mb-4 border border-base-300 px-4">
        <div class="flex-1">
          <div class="flex items-center gap-2">
            <.icon name="hero-chat-bubble-left-right" class="size-5 text-amber-200" />
            <span class="text-sm font-bold text-amber-200">AshDesk</span>
          </div>
        </div>
        <div class="flex-none flex items-center gap-2 sm:gap-4">
          <%= if assigns[:current_user] do %>
            <div class="flex items-center gap-2 sm:gap-4 text-sm">
              <span class="text-amber-200 truncate max-w-[100px] sm:max-w-none">Welcome, {@current_user.email}</span>
              <.link
                navigate={~p"/sign-out"}
                class="text-amber-200 hover:text-white transition-colors duration-200"
              >
                Sign Out
              </.link>
            </div>
          <% else %>
            <div class="flex items-center gap-4 text-sm">
              <.link
                navigate={~p"/sign-in"}
                class="text-amber-200 hover:text-white transition-colors duration-200 font-semibold"
              >
                Sign in
              </.link>
              <.link
                navigate={~p"/register"}
                class="text-amber-200 hover:text-white transition-colors duration-200 font-semibold"
              >
                Create an account
              </.link>
              <span class="text-base-content/20">|</span>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Hero section -->
      <div class="text-center mb-4">
        <div class="flex justify-center mb-4 sm:mb-8">
          <div class="avatar placeholder">
            <div class="w-16 rounded-box bg-amber-200/80 text-black">
              <.icon name="hero-chat-bubble-left-right" class="size-12 mt-2" />
            </div>
          </div>
        </div>
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl text-white">
          Welcome to <span class="text-black">AshDesk</span>
        </h1>
        <p class="mt-4 text-lg sm:text-xl text-white max-w-2xl mx-auto leading-relaxed">
          A modern support inbox for your team. Manage conversations, help customers, and keep everything organized in one place.
        </p>
      </div>

      <!-- Role navigation cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-3xl mx-auto">
        <!-- Agent / Admin card -->
        <.link navigate={~p"/inbox"} class="group block">
          <div class="relative p-5 sm:p-8 rounded-box bg-base-200/80 glass border border-base-300 transition-all duration-200 group-hover:border-primary/50 group-hover:shadow-lg group-hover:shadow-primary/5 group-hover:-translate-y-1 overflow-hidden">
            <div class="absolute top-0 right-0 w-32 h-32 bg-primary/5 rounded-full -translate-y-1/2 translate-x-1/2 transition-all duration-300 group-hover:bg-primary/10 group-hover:scale-110" />
            <div class="relative">
              <div class="flex items-center gap-2 sm:gap-3 mb-3 sm:mb-4">
                <div class="flex items-center justify-center size-10 sm:size-12 rounded-xl bg-amber-200/10 text-amber-200">
                  <.icon name="hero-inbox-stack" class="size-6" />
                </div>
                <div>
                  <h2 class="text-lg text-secondary-content sm:text-xl font-bold">
                    Support Inbox
                  </h2>
                  <p class="text-xs sm:text-sm text-secondary-content/90">Agents &amp; Admins</p>
                </div>
              </div>
              <p class="text-secondary-content/90 leading-relaxed text-xs sm:text-sm">
                View and manage support conversations. Assign agents, update statuses, and help your customers quickly.
              </p>
              <span class="inline-flex items-center gap-2 mt-4 sm:mt-6 text-sm font-semibold text-amber-200">
                Open Inbox
                <.icon
                  name="hero-arrow-right"
                  class="size-4 transition-transform duration-200 group-hover:translate-x-1"
                />
              </span>
            </div>
          </div>
        </.link>

        <!-- Customer card -->
        <.link navigate={~p"/chat"} class="group block">
          <div class="relative p-5 sm:p-8 rounded-box bg-base-200/80 glass border border-base-300 transition-all duration-200 group-hover:border-primary/50 group-hover:shadow-lg group-hover:shadow-primary/5 group-hover:-translate-y-1 overflow-hidden">
            <div class="absolute top-0 right-0 w-32 h-32 bg-primary/5 rounded-full -translate-y-1/2 translate-x-1/2 transition-all duration-300 group-hover:bg-primary/10 group-hover:scale-110" />
            <div class="relative">
              <div class="flex items-center gap-2 sm:gap-3 mb-3 sm:mb-4">
                <div class="flex items-center justify-center size-10 sm:size-12 rounded-xl bg-amber-200/10 text-amber-200">
                  <.icon name="hero-chat-bubble-left-right" class="size-6" />
                </div>
                <div>
                  <h2 class="text-lg text-secondary-content sm:text-xl font-bold">Get Help</h2>
                  <p class="text-xs sm:text-sm text-secondary-content/90">Customers</p>
                </div>
              </div>
              <p class="text-secondary-content/90 leading-relaxed text-xs sm:text-sm">
                Start a conversation with our support team. Track your requests and get the answers you need.
              </p>
              <span class="inline-flex items-center gap-2 mt-4 sm:mt-6 text-sm font-semibold text-amber-200">
                Start Chat
                <.icon
                  name="hero-arrow-right"
                  class="size-4 transition-transform duration-200 group-hover:translate-x-1"
                />
              </span>
            </div>
          </div>
        </.link>
      </div>

      <!-- Footer -->
      <footer
        data-theme="pastel"
        class="footer footer-center p-3 bg-base-200/80 glass text-amber-200 rounded-box mt-9"
      >
        <aside>
          <p class="font-bold">
            AshDesk. A Modern Support Inbox
          </p>
          <p>Built with Elixir, Phoenix and Ash</p>
        </aside>
      </footer>
    </div>
  </div>
</div>
